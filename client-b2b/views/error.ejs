<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <title>Błąd — Panel Gminy</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f5f0; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .box { background: #fff; border-radius: 12px; padding: 40px 48px; max-width: 480px; text-align: center; border: 1px solid rgba(40,52,38,0.08); }
    h2 { font-size: 18px; color: #c07a3a; margin-bottom: 12px; }
    p { font-size: 13px; color: #6b706b; font-family: monospace; word-break: break-all; }
    a { display: inline-block; margin-top: 20px; font-size: 13px; color: #354b34; font-weight: 600; }
  </style>
</head>
<body>
  <div class="box">
    <h2>Błąd połączenia B2B</h2>
    <p><%= message %></p>
    <a href="/">Spróbuj ponownie</a>
  </div>
</body>
</html>
